# Local dev (default)
# DATABASE_URL=mysql+pymysql://root:CHANGE_ME@localhost:3306/dentacademy_db

# --- Online database (TiDB Cloud) ---
# Replace the password with your cluster's root password.
# Public ISRG Root X1 CA is committed at certs/isrg-root-x1.pem (also as tidb-ca.pem).
DATABASE_URL=mysql+pymysql://<user>.root:CHANGE_ME@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/dentacademy_db
DB_SSL_REQUIRED=1
DB_SSL_CA=certs/isrg-root-x1.pem
DB_AUTO_CREATE=1

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
BCRYPT_ROUNDS=12
MODEL_PATH=ai/model.pkl
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=uploads/photos
MAX_UPLOAD_SIZE_MB=2
SECURE_COOKIES=false
ENVIRONMENT=development
AUTO_CREATE_TABLES=1
AUTO_SEED=0

# OpenRouter (experience chatbot + formal PDF report commentary) — keep the key server-side only
# If unset, PDF reports still generate with system-written formal commentary.
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_SECONDS=45
AI_APP_NAME=DentAcademy Experience Chat

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=DentAcademy <no-reply@dentacademy.co.za>
PASSWORD_RESET_EXPIRE_MINUTES=30

# =============================================================================
# Render free production (see root render.yaml)
# =============================================================================
# 1. Push repo to GitHub → Render → New → Blueprint → select this repo.
# 2. When prompted, set DATABASE_URL to your TiDB Cloud MySQL URL, e.g.:
#    mysql+pymysql://USER:PASSWORD@gateway01.…tidbcloud.com:4000/dentacademy_db
# 3. Blueprint sets: ENVIRONMENT=production, DB_SSL_*, AUTO_CREATE_TABLES=1,
#    AUTO_SEED=1, SECURE_COOKIES=true, DB_SSL_CA=certs/isrg-root-x1.pem,
#    and generates JWT_SECRET_KEY.
# 4. FRONTEND_URL / CORS_ORIGINS auto-use RENDER_EXTERNAL_URL when unset.
# 5. After first login with seeded admin, set AUTO_SEED=0 in Render and redeploy.
# 6. Optional dashboard env: OPENROUTER_API_KEY=
# 7. Free-tier notes: service sleeps after ~15m idle; uploads are ephemeral;
#    outbound SMTP (password reset mail) is blocked on Render free.
